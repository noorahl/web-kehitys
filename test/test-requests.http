# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/41

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2023-12-25",
    "weight": 4,
    "owner": 37,
    "filename": "rolle.jpg"
}


### post cat WITH IMAGE
POST {{apiUrl}}/cats
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Maukuu
--MyBoundary
Content-Disposition: form-data; name="weight"

4
--MyBoundary
Content-Disposition: form-data; name="owner"

37
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2022-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/41
Content-Type: application/json

{
    "weight": 6,
    "owner": 37
}

### delete cat by id
DELETE {{apiUrl}}/cats/2

### Get all cats belonging to user 37
GET {{apiUrl}}/cats/user/37

### get users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/1

### get user by id (FAIL: not found)
GET {{apiUrl}}/users/98

### post new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Liisa",
    "username": "liisa",
    "email": "liisa@metropolia.fi",
    "role": "user",
    "password": "password"
  }

### edit existing user
PUT {{apiUrl}}/users/1
Content-Type: application/json

{
    "email": "nikkes@metropolia.fi",
    "role": "user",
    "password": "password1"
  }

### delete user by id
DELETE {{apiUrl}}/users/37
